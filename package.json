{
  "name": "@item-enonic-types/lib-next-jobs",
  "version": "0.1.0",
  "description": "Types and stylesheets for lib-xp-next-jobs: job openings from Next on an Enonic XP site",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "tsconfig.json"
  ],
  "scripts": {
    "clean": "rimraf build dist",
    "build": "concurrently -c auto -g --timings npm:build:*",
    "minify": "concurrently -c auto -g --timings 'npm:build:asset -- --minify' npm:build:postcss npm:build:server",
    "build:asset": "npx tsup -d build/resources/main/assets",
    "build:postcss": "npx postcss src/main/resources/assets/next-jobs/next-jobs.css -m -d build/resources/main/assets --base src/main/resources/assets --ext min.css",
    "build:server": "npx tsup -d build/resources/main",
    "check": "concurrently -c auto -g --timings npm:lint npm:lint:css npm:check:types",
    "check:types": "concurrently -g -r --timings npm:check:types:*",
    "check:types:asset": "npx tsc --noEmit -p src/main/resources/assets/tsconfig.json",
    "check:types:server": "npx tsc --noEmit -p src/main/resources/tsconfig.json",
    "lint": "eslint --cache \"src/main/resources/**/*.ts\"",
    "lint:css": "stylelint \"src/main/resources/**/*.css\"",
    "prepublishOnly": "npm run clean && concurrently -c auto -g --timings npm:prepublish:*",
    "prepublish:types": "tsc -p src/main/resources/tsconfig.json --noEmit false --declaration --emitDeclarationOnly --declarationDir dist",
    "prepublish:generated": "mkdir -p dist && cp -R .xp-codegen/. dist",
    "prepublish:styles": "mkdir -p dist/styles && cp src/main/resources/lib/next-jobs/views/*.css dist/styles",
    "versioning": "npx changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/^version.*/version = ${NEW_VERSION}/\" gradle.properties"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@enonic-types/core": "^7.15.4",
    "@enonic-types/global": "^7.15.4",
    "@enonic-types/lib-asset": "^1.0.3",
    "@enonic-types/lib-auth": "^7.15.4",
    "@enonic-types/lib-content": "^7.15.4",
    "@enonic-types/lib-context": "^7.15.4",
    "@enonic-types/lib-i18n": "^7.15.4",
    "@enonic-types/lib-node": "^7.15.4",
    "@enonic-types/lib-portal": "^7.15.4",
    "@enonic-types/lib-repo": "^7.15.4",
    "@item-enonic-types/global": "^7.15.0",
    "@item-enonic-types/lib-freemarker": "^3.0.0",
    "@item-enonic-types/lib-http-client": "^3.2.2",
    "@item-enonic-types/lib-time": "^1.2.1",
    "@swc/core": "^1.13.5",
    "@types/node": "^26.1.1",
    "autoprefixer": "^10.5.2",
    "concurrently": "^9.2.1",
    "cssnano": "^8.0.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "glob": "^11.0.3",
    "postcss": "^8.5.18",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-url": "^10.1.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
